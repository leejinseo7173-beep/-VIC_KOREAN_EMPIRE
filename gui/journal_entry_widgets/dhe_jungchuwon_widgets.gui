### DHE custom Jungchuwon journal widgets

flowcontainer = {
	name = "widget_je_dhe_jungchuwon_header"
	ignoreinvisible = yes
	direction = vertical
	parentanchor = hcenter
	spacing = 8

	widget = {
		size = { 500 74 }
		maximumsize = { 500 74 }
		parentanchor = hcenter
		tooltip = "dhe_jungchuwon_widget_tt"

		background = {
			using = entry_bg
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			margin = { 10 8 }
			spacing = 8

			vbox = {
				layoutpolicy_horizontal = growing
				layoutpolicy_vertical = expanding
				spacing = 4
				tooltip = "dhe_jungchuwon_widget_royal_desc"

				icon = {
					texture = "gfx/interface/icons/law_icons/monarchy.dds"
					size = { 34 34 }
					parentanchor = hcenter
				}

				textbox = {
					text = "dhe_jungchuwon_widget_royal"
					align = center|nobaseline
					size = { 105 22 }
					maximumsize = { 105 22 }
					parentanchor = hcenter
					default_format = "#v"
					using = fontsize_medium
					elide = right
				}
			}

			vbox = {
				layoutpolicy_horizontal = growing
				layoutpolicy_vertical = expanding
				spacing = 4
				tooltip = "dhe_jungchuwon_widget_reform_desc"

				icon = {
					texture = "gfx/interface/icons/event_icons/event_newspaper.dds"
					size = { 34 34 }
					parentanchor = hcenter
				}

				textbox = {
					text = "dhe_jungchuwon_widget_reform"
					align = center|nobaseline
					size = { 105 22 }
					maximumsize = { 105 22 }
					parentanchor = hcenter
					default_format = "#v"
					using = fontsize_medium
					elide = right
				}
			}

			vbox = {
				layoutpolicy_horizontal = growing
				layoutpolicy_vertical = expanding
				spacing = 4
				tooltip = "dhe_jungchuwon_widget_provincial_desc"

				icon = {
					texture = "gfx/interface/icons/invention_icons/bureaucracy.dds"
					size = { 34 34 }
					parentanchor = hcenter
				}

				textbox = {
					text = "dhe_jungchuwon_widget_provincial"
					align = center|nobaseline
					size = { 105 22 }
					maximumsize = { 105 22 }
					parentanchor = hcenter
					default_format = "#v"
					using = fontsize_medium
					elide = right
				}
			}

			vbox = {
				layoutpolicy_horizontal = growing
				layoutpolicy_vertical = expanding
				spacing = 4
				tooltip = "dhe_jungchuwon_widget_trust_desc"

				icon = {
					texture = "gfx/interface/icons/event_icons/event_scales.dds"
					size = { 34 34 }
					parentanchor = hcenter
				}

				textbox = {
					text = "dhe_jungchuwon_widget_trust"
					align = center|nobaseline
					size = { 105 22 }
					maximumsize = { 105 22 }
					parentanchor = hcenter
					default_format = "#v"
					using = fontsize_medium
					elide = right
				}
			}
		}
	}
}
